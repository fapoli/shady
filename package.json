{
  "name": "shady",
  "version": "1.0.0",
  "description": "A minimal shader editor.",
  "author": {
    "name": "Federico Poli",
    "email": "fapoli@gmail.com"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "npm run build && electron-builder",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:all": "npm run build && electron-builder --mac --win --linux",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.federicopoli.shady",
    "productName": "Shady",
    "artifactName": "shady-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "target": "dmg",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Shady uses the microphone as an audio-reactive shader input."
      }
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "category": "Graphics",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.52.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "typescript": "^6.0.3",
    "vite": "^5.4.11"
  }
}
